CONN_ADMIN=Host=localhost;Port=5433;Database=laundry_admin;Username=laundry;Password=CHANGE_ME
CONN_CLOUD=Host=localhost;Port=5434;Database=laundry_cloud;Username=laundry;Password=CHANGE_ME
ENVIRONMENT=Development
JWT_KEY=CHANGE_ME_MIN_32_BYTES

# Tanda tangan HMAC-SHA256 untuk POST /api/payments/gateway/webhook (D-12).
# Minimal 16 karakter dan JANGAN biarkan CHANGE_ME — kalau begitu semua webhook ditolak 401
# dan tagihan QRIS simulasi tidak bisa berubah jadi lunas.
WEBHOOK_SECRET=CHANGE_ME_MIN_16_KARAKTER

# Opsional — punya nilai bawaan di kode, tulis hanya bila ingin mengubah.
# AUTH_RATE_LIMIT_PER_MENIT=10      # pembatas permintaan auth per menit per klien
# SYNC_BATCH=100                    # event per arah per siklus worker (maks 500)
# SYNC_INTERVAL_DETIK=15            # jeda antar siklus worker
# SEED_DEV_CONTOH=1                 # isi katalog contoh berlabel (CONTOH) saat API dev mulai

# Backup & pemulihan (D-14). Berkas ini tidak ikut ke git; path di bawah hanya contoh, nilai
# bawaannya dihitung aplikasi dari folder profil pengguna (%LOCALAPPDATA%\pgsql17\... dan
# %LOCALAPPDATA%\laundry-pg\backups) — variabel lingkungan tidak memperluas %...%, jadi tulis
# path lengkap apa adanya kalau ingin memindahkannya.
# PG_BIN=C:\Users\NamaPengguna\AppData\Local\pgsql17\pgsql\bin
# BACKUP_DIR=C:\Users\NamaPengguna\AppData\Local\laundry-pg\backups
# BACKUP_TIMEOUT_DETIK=300          # batas waktu pg_dump/pg_restore per panggilan
# BACKUP_AUTO=1                     # 0 = pekerja backup harian di Laundry.Api dimatikan
# BACKUP_CEK_MENIT=30               # jeda antar pemeriksaan "apakah backup harian perlu diulang"

# Rilis & pemeriksaan versi. UPDATE_CHECK_URL menunjuk ke manifest JSON {versi,url,sha256,catatan};
# selama kosong, /api/app/update-check menjawab "belum_dikonfigurasi" (bukan "sudah terbaru").
# UPDATE_DIR adalah folder tempat installer hasil unduhan manual diletakkan untuk dicek sha256-nya.
# UPDATE_CHECK_URL=
# UPDATE_DIR=C:\Users\NamaPengguna\AppData\Local\laundry-pg\downloads
