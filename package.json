{
  "name": "laundryflow-desk",
  "version": "1.0.0",
  "description": "Aplikasi kasir & manajemen laundry",
  "author": "arkenzojunior21",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "seed-demo": "electron . --seed-demo",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.laundryflow.desk",
    "productName": "LaundryFlow Desk",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}
