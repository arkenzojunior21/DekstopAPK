<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\backend\Laundry.Application\Laundry.Application.csproj" />
    <ProjectReference Include="..\..\backend\Laundry.Domain\Laundry.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Aset yang bisa diganti admin tanpa build ulang: logo.png di root Aset,
       foto layanan di Aset/Layanan/<nama-layanan-slug>.png. -->
  <ItemGroup>
    <None Remove="Aset\**" />
    <Content Include="Aset\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
