<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palet gelap. Nama kunci sama persis dengan Terang.xaml: yang boleh berbeda hanya nilainya.
         Warna mengikuti keluarga hijau yang sama supaya ganti tema tidak terasa seperti aplikasi lain. -->
    <Color x:Key="WarnaLatar">#FF0F1513</Color>
    <Color x:Key="WarnaPermukaan">#FF18201D</Color>
    <Color x:Key="WarnaPermukaanDua">#FF1F2A26</Color>
    <Color x:Key="WarnaSisi">#FF0E3B33</Color>
    <Color x:Key="WarnaSisiTeks">#FFBFD8D1</Color>
    <Color x:Key="WarnaGaris">#FF2C3A35</Color>
    <Color x:Key="WarnaTeks">#FFEDF2F0</Color>
    <Color x:Key="WarnaTeksDua">#FF9AABA5</Color>
    <Color x:Key="WarnaAksen">#FF4FC3AE</Color>
    <Color x:Key="WarnaAksenGelap">#FF7DD8C6</Color>
    <Color x:Key="WarnaSukses">#FF46D3B4</Color>
    <Color x:Key="WarnaProses">#FFE8B45A</Color>
    <Color x:Key="WarnaBahaya">#FFF08A80</Color>
    <Color x:Key="WarnaNetral">#FF9AABA5</Color>

    <SolidColorBrush x:Key="KuasLatar" Color="{StaticResource WarnaLatar}" />
    <SolidColorBrush x:Key="KuasPermukaan" Color="{StaticResource WarnaPermukaan}" />
    <SolidColorBrush x:Key="KuasPermukaanDua" Color="{StaticResource WarnaPermukaanDua}" />
    <SolidColorBrush x:Key="KuasSisi" Color="{StaticResource WarnaSisi}" />
    <SolidColorBrush x:Key="KuasSisiTeks" Color="{StaticResource WarnaSisiTeks}" />
    <SolidColorBrush x:Key="KuasGaris" Color="{StaticResource WarnaGaris}" />
    <SolidColorBrush x:Key="KuasTeks" Color="{StaticResource WarnaTeks}" />
    <SolidColorBrush x:Key="KuasTeksDua" Color="{StaticResource WarnaTeksDua}" />
    <SolidColorBrush x:Key="KuasAksen" Color="{StaticResource WarnaAksen}" />
    <SolidColorBrush x:Key="KuasAksenGelap" Color="{StaticResource WarnaAksenGelap}" />
    <SolidColorBrush x:Key="KuasSukses" Color="{StaticResource WarnaSukses}" />
    <SolidColorBrush x:Key="KuasProses" Color="{StaticResource WarnaProses}" />
    <SolidColorBrush x:Key="KuasBahaya" Color="{StaticResource WarnaBahaya}" />
    <SolidColorBrush x:Key="KuasNetral" Color="{StaticResource WarnaNetral}" />

    <SolidColorBrush x:Key="KuasSuksesLembut" Color="#FF12332C" />
    <SolidColorBrush x:Key="KuasProsesLembut" Color="#FF332811" />
    <SolidColorBrush x:Key="KuasBahayaLembut" Color="#FF3A1D19" />
    <SolidColorBrush x:Key="KuasAksenLembut" Color="#FF14332D" />

    <!-- Tinta gelap untuk teks di atas isian terang (tombol primer/sukses/bahaya di tema gelap),
         supaya kontrasnya lolos AA; tema terang memakai putih karena isiannya gelap. -->
    <SolidColorBrush x:Key="KuasAksenTinta" Color="#FF0F1513" />
    <SolidColorBrush x:Key="KuasSuksesTinta" Color="#FF0F1513" />
    <SolidColorBrush x:Key="KuasBahayaTinta" Color="#FF0F1513" />

    <!-- Kuas khusus contoh desain. -->
    <SolidColorBrush x:Key="KuasSisiAktif" Color="#FF1B2622" />
    <SolidColorBrush x:Key="KuasIsian" Color="#FF1A231F" />
    <SolidColorBrush x:Key="KuasIlustrasi" Color="#FF2A241C" />
    <SolidColorBrush x:Key="KuasPanelLembut" Color="#FF1D2925" />

</ResourceDictionary>
