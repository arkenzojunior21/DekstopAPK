<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palet terang mengikuti contoh desain: hijau tua untuk sisi dan tombol,
         latar krem, kartu putih, garis tipis abu-hangat. Semua kontrol membaca kuas ini
         lewat DynamicResource supaya ganti tema tidak perlu menyentuh satu pun style. -->
    <Color x:Key="WarnaLatar">#FFF6F7F5</Color>
    <Color x:Key="WarnaPermukaan">#FFFFFFFF</Color>
    <Color x:Key="WarnaPermukaanDua">#FFF1F3EF</Color>
    <Color x:Key="WarnaSisi">#FF17695E</Color>
    <Color x:Key="WarnaSisiTeks">#FFCFE4DE</Color>
    <Color x:Key="WarnaGaris">#FFDCE0D9</Color>
    <Color x:Key="WarnaTeks">#FF202C32</Color>
    <Color x:Key="WarnaTeksDua">#FF5B666B</Color>
    <Color x:Key="WarnaAksen">#FF17695E</Color>
    <Color x:Key="WarnaAksenGelap">#FF12544A</Color>
    <Color x:Key="WarnaSukses">#FF0E6B57</Color>
    <Color x:Key="WarnaProses">#FF9A6A16</Color>
    <Color x:Key="WarnaBahaya">#FFA33B33</Color>
    <Color x:Key="WarnaNetral">#FF5B666B</Color>

    <SolidColorBrush x:Key="KuasLatar" Color="{StaticResource WarnaLatar}" />
    <SolidColorBrush x:Key="KuasPermukaan" Color="{StaticResource WarnaPermukaan}" />
    <SolidColorBrush x:Key="KuasPermukaanDua" Color="{StaticResource WarnaPermukaanDua}" />
    <SolidColorBrush x:Key="KuasSisi" Color="{StaticResource WarnaSisi}" />
    <SolidColorBrush x:Key="KuasSisiTeks" Color="{StaticResource WarnaSisiTeks}" />
    <SolidColorBrush x:Key="KuasGaris" Color="{StaticResource WarnaGaris}" />
    <SolidColorBrush x:Key="KuasTeks" Color="{StaticResource WarnaTeks}" />
    <SolidColorBrush x:Key="KuasTeksDua" Color="{StaticResource WarnaTeksDua}" />
    <SolidColorBrush x:Key="KuasAksen" Color="{StaticResource WarnaAksen}" />
    <SolidColorBrush x:Key="KuasAksenGelap" Color="{StaticResource WarnaAksenGelap}" />
    <SolidColorBrush x:Key="KuasSukses" Color="{StaticResource WarnaSukses}" />
    <SolidColorBrush x:Key="KuasProses" Color="{StaticResource WarnaProses}" />
    <SolidColorBrush x:Key="KuasBahaya" Color="{StaticResource WarnaBahaya}" />
    <SolidColorBrush x:Key="KuasNetral" Color="{StaticResource WarnaNetral}" />

    <SolidColorBrush x:Key="KuasSuksesLembut" Color="#FFD5F6F1" />
    <SolidColorBrush x:Key="KuasProsesLembut" Color="#FFF8EEDA" />
    <SolidColorBrush x:Key="KuasBahayaLembut" Color="#FFF8E5E2" />
    <SolidColorBrush x:Key="KuasAksenLembut" Color="#FFE3EFEA" />

    <!-- Isian tombol primer cukup gelap untuk teks putih (lihat catatan di Gelap.xaml). -->
    <SolidColorBrush x:Key="KuasAksenTinta" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="KuasSuksesTinta" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="KuasBahayaTinta" Color="#FFFFFFFF" />

    <!-- Kuas khusus contoh desain. -->
    <SolidColorBrush x:Key="KuasSisiAktif" Color="#FF202C32" />
    <SolidColorBrush x:Key="KuasIsian" Color="#FFF6F7F5" />
    <SolidColorBrush x:Key="KuasIlustrasi" Color="#FFFBF3E9" />
    <SolidColorBrush x:Key="KuasPanelLembut" Color="#FFE7ECE2" />

</ResourceDictionary>
