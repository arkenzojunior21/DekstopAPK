<Window x:Class="Laundry.Desktop.Views.JendelaLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Laundry.Desktop.Services"
        Title="Laundry — Masuk" Height="720" Width="1120" MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource KuasLatar}"
        FontFamily="{StaticResource FontUtama}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46*" />
            <ColumnDefinition Width="54*" />
        </Grid.ColumnDefinitions>

        <!-- Panel kiri: identitas aplikasi. Pengaturan server tidak ditampilkan
             di sini — alamat API diatur lewat variabel lingkungan API_URL atau
             berkas preferensi sebelum aplikasi dibuka. -->
        <Border Grid.Column="0" Background="{DynamicResource KuasSisi}" Padding="56,48,56,40">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SISTEM KASIR DESKTOP" Foreground="#B9DAD2"
                           FontSize="12" FontWeight="Bold" />
                <TextBlock Text="Laundry Desk" Foreground="White" FontSize="46" FontWeight="Bold"
                           Margin="0,14,0,0" />
                <TextBlock Text="Aplikasi operasional harian untuk penerimaan cucian, pelacakan proses, dan pencatatan kasir."
                           Foreground="{DynamicResource KuasSisiTeks}" FontSize="16.5" LineHeight="25"
                           TextWrapping="Wrap" MaxWidth="430" Margin="0,20,0,0" />
            </StackPanel>
        </Border>

        <!-- Panel kanan: form. -->
        <Grid Grid.Column="1" Margin="48,36,40,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" MaxWidth="420" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="{Binding JudulMode}" Style="{StaticResource TeksJudul}" FontSize="34" />
                <TextBlock Text="{Binding KeteranganMode}"
                           Style="{StaticResource TeksSub}" FontSize="13.5" Margin="0,6,0,0" />
                <StackPanel Visibility="{Binding LagiMasuk, Converter={StaticResource BoolKasus}}">
                    <TextBlock Text="{Binding PesanUmum}" Style="{StaticResource TeksSub}" Margin="0,6,0,0"
                               Visibility="{Binding PesanUmum, Converter={StaticResource Kosong}}" />
                </StackPanel>

                <ContentControl Visibility="{Binding Galat, Converter={StaticResource Kosong}}"
                                Content="{Binding Galat}" ContentTemplate="{StaticResource BarisGalat}"
                                Margin="0,14,0,0" />
                <ContentControl Visibility="{Binding Info, Converter={StaticResource Kosong}}"
                                Content="{Binding Info}" ContentTemplate="{StaticResource BarisHasil}"
                                Margin="0,14,0,0" />

                <TextBox Style="{StaticResource KotakLabel}" Tag="NOMOR TELEPON" Margin="0,18,0,0"
                         Text="{Binding Nomor, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Visibility="{Binding LagiMasuk, Converter={StaticResource BoolKasus}}">
                    <PasswordBox x:Name="KotakSandi" Style="{StaticResource KotakSandi}" Tag="KATA SANDI"
                                 Margin="0,12,0,0" PasswordChanged="KotakSandi_Changed" />
                    <Button Content="Masuk ke Sistem" Style="{StaticResource Tombol}" Command="{Binding MasukCommand}"
                            Margin="0,18,0,0" Height="52" FontSize="15" IsDefault="True" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Belum terdaftar?" Style="{StaticResource TeksKecil}"
                                       VerticalAlignment="Center" />
                            <Button Content="Daftar" Command="{Binding PilihModeCommand}"
                                    CommandParameter="Daftar" Style="{StaticResource TombolHalus}"
                                    Foreground="{DynamicResource KuasAksen}" Padding="4,2,4,2" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Lupa sandi?" Command="{Binding PilihModeCommand}"
                                CommandParameter="Lupa" Style="{StaticResource TombolHalus}"
                                Foreground="{DynamicResource KuasAksen}" Padding="4,2,4,2" />
                    </Grid>
                </StackPanel>

                <StackPanel Visibility="{Binding LagiDaftar, Converter={StaticResource BoolKasus}}">
                    <TextBox Style="{StaticResource KotakLabel}" Tag="NAMA USAHA / NAMA KAMU" Margin="0,12,0,0"
                             Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Kirim kode verifikasi" Style="{StaticResource TombolGaris}"
                            Command="{Binding DaftarMulaiCommand}" Margin="0,12,0,0" Height="44" />
                    <TextBox Style="{StaticResource KotakLabel}" Tag="KODE DARI WHATSAPP" Margin="0,12,0,0"
                             Text="{Binding KodeOtp, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding KodeDev, StringFormat=Kode pengembangan: {0}}" Style="{StaticResource TeksKecil}"
                               Visibility="{Binding KodeDev, Converter={StaticResource Kosong}}" Margin="0,6,0,0" />
                    <PasswordBox x:Name="KotakSandiBaru" Style="{StaticResource KotakSandi}"
                                 Tag="KATA SANDI BARU" Margin="0,12,0,0"
                                 PasswordChanged="KotakSandiBaru_Changed" />
                    <Button Content="Selesaikan pendaftaran" Style="{StaticResource Tombol}"
                            Command="{Binding DaftarSelesaiCommand}" Margin="0,18,0,0" Height="52"
                            FontSize="15" IsDefault="True" />
                    <Button Content="Kembali ke masuk" Command="{Binding PilihModeCommand}"
                            CommandParameter="Masuk" Style="{StaticResource TombolHalus}"
                            Foreground="{DynamicResource KuasAksen}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" />
                </StackPanel>

                <StackPanel Visibility="{Binding LagiLupa, Converter={StaticResource BoolKasus}}">
                    <Button Content="Kirim kode reset" Style="{StaticResource TombolGaris}"
                            Command="{Binding LupaMulaiCommand}" Margin="0,12,0,0" Height="44" />
                    <TextBox Style="{StaticResource KotakLabel}" Tag="KODE RESET" Margin="0,12,0,0"
                             Text="{Binding KodeOtp, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding KodeDev, StringFormat=Kode pengembangan: {0}}" Style="{StaticResource TeksKecil}"
                               Visibility="{Binding KodeDev, Converter={StaticResource Kosong}}" Margin="0,6,0,0" />
                    <PasswordBox x:Name="KotakSandiReset" Style="{StaticResource KotakSandi}"
                                 Tag="KATA SANDI BARU" Margin="0,12,0,0"
                                 PasswordChanged="KotakSandiReset_Changed" />
                    <Button Content="Ganti kata sandi" Style="{StaticResource Tombol}"
                            Command="{Binding LupaSelesaiCommand}" Margin="0,18,0,0" Height="52"
                            FontSize="15" IsDefault="True" />
                    <Button Content="Kembali ke masuk" Command="{Binding PilihModeCommand}"
                            CommandParameter="Masuk" Style="{StaticResource TombolHalus}"
                            Foreground="{DynamicResource KuasAksen}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" />
                </StackPanel>

                <ProgressBar Margin="0,18,0,0" Width="120" HorizontalAlignment="Left" Style="{StaticResource Progres}"
                             Visibility="{Binding Sibuk, Converter={StaticResource BoolKasus}}" />
            </StackPanel>

            <!-- Ilustrasi kecil di kanan form, mengikuti contoh desain. -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,0,0" Width="210">
                <Border Background="{DynamicResource KuasIlustrasi}" CornerRadius="{StaticResource Radius}"
                        Padding="14">
                    <Image Source="{Binding Converter={StaticResource AsetGambar}, ConverterParameter=ilustrasi-login.jpg}"
                           Stretch="Uniform" />
                </Border>
                <TextBlock Text="Loket Kasir Siap" Style="{StaticResource TeksData}" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Text="Buka shift kasir sebelum memproses nota pelanggan baru."
                           Style="{StaticResource TeksKecil}" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
