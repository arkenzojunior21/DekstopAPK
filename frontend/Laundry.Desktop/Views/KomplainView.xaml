<UserControl x:Class="Laundry.Desktop.Views.KomplainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Kiri: daftar tiket + filter. -->
        <DockPanel Grid.Column="0" LastChildFill="True">
            <Border DockPanel.Dock="Top" Style="{StaticResource Kartu}" Padding="14,12,14,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="STATUS" Style="{StaticResource TeksLabel}" />
                        <ComboBox Style="{StaticResource KotakPilih}" ItemsSource="{Binding SemuaStatus}"
                                  SelectedItem="{Binding FilterStatus}" Tag="semua status"
                                  ItemTemplate="{StaticResource TemplateEnum}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Filter" Style="{StaticResource TombolGaris}"
                            VerticalAlignment="Bottom" Margin="10,0,0,0" Command="{Binding TerapkanFilterCommand}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Kartu}" Padding="0">
                <Grid>
                    <DataGrid Style="{StaticResource TabelData}" ItemsSource="{Binding Daftar}"
                              SelectedItem="{Binding Terpilih}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pesanan" Binding="{Binding Nomor}" Width="178"
                                                ElementStyle="{StaticResource SelPotong}" />
                            <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="*" />
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status, Converter={StaticResource Label}}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Belum ada tiket komplain pada filter ini."
                               Style="{StaticResource TeksKecil}" TextWrapping="Wrap" Margin="18,56,18,18"
                               Visibility="{Binding Daftar.Count, Converter={StaticResource Kosong}, ConverterParameter=balik}" />
                </Grid>
            </Border>
        </DockPanel>

        <ScrollViewer Grid.Column="2" Style="{StaticResource Gulir}">
            <StackPanel>
                <ContentControl Content="{Binding Galat}" ContentTemplate="{StaticResource BarisGalat}"
                                Visibility="{Binding Galat, Converter={StaticResource Kosong}}" />
                <ContentControl Content="{Binding Hasil}" ContentTemplate="{StaticResource BarisHasil}"
                                Visibility="{Binding Hasil, Converter={StaticResource Kosong}}" />

                <!-- Buat tiket: khusus pelanggan. -->
                <Border Style="{StaticResource Kartu}" Margin="0,0,0,12"
                        Visibility="{Binding Admin, Converter={StaticResource BoolKasus}, ConverterParameter=balik}">
                    <StackPanel>
                        <TextBlock Text="KOMPLAIN BARU" Style="{StaticResource TeksLabel}" />
                        <TextBlock Text="PESANAN" Style="{StaticResource TeksLabel}" Margin="0,10,0,0" />
                        <ComboBox Style="{StaticResource KotakPilih}" ItemsSource="{Binding PesananAktif}"
                                  SelectedItem="{Binding PesananDipilih}" Tag="pilih pesanan">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12.5">
                                        <Run Text="{Binding OrderNumber, Mode=OneWay}" /><Run Text=" · " /><Run
                                            Text="{Binding Status, Converter={StaticResource Label}, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="KATEGORI" Style="{StaticResource TeksLabel}" Margin="0,10,0,0" />
                        <TextBox Style="{StaticResource KotakTeks}" Tag="mis. Kualitas"
                                 Text="{Binding Kategori, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="JELASKAN KEJADIANNYA" Style="{StaticResource TeksLabel}" Margin="0,10,0,0" />
                        <TextBox Style="{StaticResource KotakTeksBesar}" Height="72" TextWrapping="Wrap"
                                 Tag="apa yang terjadi?" AcceptsReturn="True"
                                 Text="{Binding IsiKomplain, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Kirim komplain" Style="{StaticResource Tombol}" Margin="0,12,0,0" Height="34"
                                HorizontalAlignment="Left" Command="{Binding BuatCommand}" />
                        <TextBlock Style="{StaticResource TeksKecil}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Hanya pesanan milik sendiri yang muncul di daftar ini; server yang membatasi aksesnya." />
                    </StackPanel>
                </Border>

                <!-- Belum ada tiket terpilih: panel kosong terlihat seperti rusak. -->
                <Border Style="{StaticResource KartuLembut}" Margin="0,0,0,12"
                        Visibility="{Binding AdaTerpilih, Converter={StaticResource BoolKasus}, ConverterParameter=balik}">
                    <TextBlock Style="{StaticResource TeksKecil}" TextWrapping="Wrap"
                               Text="Pilih satu tiket di daftar kiri untuk membaca isinya dan membalas." />
                </Border>
                <!-- Isi tiket. -->
                <Border Style="{StaticResource Kartu}" Margin="0,0,0,12"
                        Visibility="{Binding AdaTerpilih, Converter={StaticResource BoolKasus}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Terpilih.Nomor}" Style="{StaticResource TeksJudul}" />
                                <TextBlock Text="{Binding Terpilih.Kategori}" Style="{StaticResource TeksSub}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource Lencana}"
                                    Background="{Binding Terpilih.Status, Converter={StaticResource KuasStatus}}">
                                <TextBlock Style="{StaticResource TeksLencana}" Foreground="White"
                                           Text="{Binding Terpilih.Status, Converter={StaticResource Label}}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Terpilih.Isi}" Style="{StaticResource TeksData}" TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource TeksKecil}" Margin="0,6,0,0"
                                   Text="{Binding Terpilih.Dibuat, StringFormat=Dibuat: {0}}" />

                        <Separator />
                        <TextBlock Text="BALASAN" Style="{StaticResource TeksLabel}" />
                        <ItemsControl ItemsSource="{Binding Terpilih.Pesan}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource KuasPermukaanDua}" CornerRadius="8"
                                            Padding="12,9,12,9" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TeksLabel}"
                                                       Text="{Binding Pengirim, StringFormat={}{0}}" />
                                            <TextBlock Text="{Binding Isi}" TextWrapping="Wrap" FontSize="12.5"
                                                       Foreground="{DynamicResource KuasTeks}" Margin="0,4,0,0" />
                                            <TextBlock Style="{StaticResource TeksKecil}" Margin="0,4,0,0"
                                                       Text="{Binding Kapan}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource TeksKecil}" TextWrapping="Wrap"
                                   Text="Tidak ada balasan."
                                   Visibility="{Binding Terpilih.Pesan.Count, Converter={StaticResource Kosong}, ConverterParameter=balik, FallbackValue=Collapsed}" />

                        <TextBox Style="{StaticResource KotakTeksBesar}" Height="60" TextWrapping="Wrap"
                                 AcceptsReturn="True" Margin="0,10,0,0" Tag="tulis balasan…"
                                 Text="{Binding Balasan, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Kirim balasan" Style="{StaticResource Tombol}" Margin="0,10,0,0" Height="34"
                                HorizontalAlignment="Left" Command="{Binding BalasCommand}" />
                    </StackPanel>
                </Border>

                <!-- Status: khusus admin. -->
                <Border Style="{StaticResource Kartu}"
                        Visibility="{Binding BisaUbahStatus, Converter={StaticResource BoolKasus}}">
                    <StackPanel>
                        <TextBlock Text="STATUS TIKET" Style="{StaticResource TeksLabel}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Style="{StaticResource KotakPilih}"
                                      ItemsSource="{Binding SemuaStatus}" SelectedItem="{Binding StatusBaru}"
                                      ItemTemplate="{StaticResource TemplateEnum}" />
                            <Button Grid.Column="1" Content="Simpan status" Style="{StaticResource Tombol}"
                                    Margin="10,0,0,0" Command="{Binding GantiStatusCommand}" />
                        </Grid>
                        <TextBlock Style="{StaticResource TeksKecil}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Setiap perubahan status tercatat sebagai baris audit baru dan tidak bisa dihapus dari aplikasi." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
