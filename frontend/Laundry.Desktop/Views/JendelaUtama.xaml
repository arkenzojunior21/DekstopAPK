<Window x:Class="Laundry.Desktop.Views.JendelaUtama"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Laundry.Desktop.ViewModels"
        xmlns:v="clr-namespace:Laundry.Desktop.Views"
        Title="Laundry Desk" Height="760" Width="1200" MinHeight="540" MinWidth="880"
        Language="id-ID"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource KuasLatar}"
        FontFamily="{StaticResource FontUtama}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:BerandaAdminViewModel}">
            <v:BerandaAdminView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BerandaPelangganViewModel}">
            <v:BerandaPelangganView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PesananViewModel}">
            <v:PesananView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PesanBaruViewModel}">
            <v:PesanBaruView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KatalogViewModel}">
            <v:KatalogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PelangganViewModel}">
            <v:PelangganView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SlotViewModel}">
            <v:SlotView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KomplainViewModel}">
            <v:KomplainView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LaporanViewModel}">
            <v:LaporanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}">
            <v:AuditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PesananSayaViewModel}">
            <v:PesananSayaView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="KolomSisi" Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sisi kiri: menu sesuai peran. Menyempit jadi rel ikon saat jendela sempit. -->
        <Border Grid.Column="0" Background="{DynamicResource KuasSisi}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="26,28,22,22" Orientation="Horizontal"
                            x:Name="BarisLogo">
                    <Grid Width="30" Height="30">
                        <!-- Huruf "L" jadi cadangan bila Aset/logo.png belum ada. -->
                        <Border CornerRadius="8" Background="#22FFFFFF">
                            <TextBlock Text="L" Foreground="White" FontWeight="Bold" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding Converter={StaticResource AsetGambar}, ConverterParameter=logo.png}"
                               Width="30" Height="30" Stretch="UniformToFill">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, RelativeSource={RelativeSource Self}}"
                                                     Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding DataContext.Sempit, RelativeSource={RelativeSource AncestorType=Window},
                                             Converter={StaticResource BoolKasus}, ConverterParameter=balik}">
                        <TextBlock Text="Laundry Desk" Foreground="White" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding Sesi.Peran}" Foreground="{DynamicResource KuasSisiTeks}"
                                   FontSize="11.5" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="26,10,18,22">
                    <TextBlock Text="{Binding StatusSinkron}" Foreground="{DynamicResource KuasSisiTeks}"
                               FontSize="11.5" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding StatusSinkron, Converter={StaticResource Kosong}}" />
                    <Border Height="1" Background="#2EFFFFFF" Margin="0,0,0,12" />
                    <Button Command="{Binding GantiTemaCommand}" Style="{StaticResource TombolHalus}"
                            Foreground="{DynamicResource KuasSisiTeks}" HorizontalContentAlignment="Left"
                            ToolTip="Ganti tema tampilan">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE706;" FontFamily="{StaticResource FontIkon}" Margin="2,0,10,0" />
                            <TextBlock Text="{Binding NamaTema, StringFormat=Tema: {0}}"
                                       Visibility="{Binding DataContext.Sempit, RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolKasus}, ConverterParameter=balik}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding KeluarCommand}" Style="{StaticResource TombolHalus}"
                            Foreground="{DynamicResource KuasSisiTeks}" HorizontalContentAlignment="Left"
                            ToolTip="Keluar dari aplikasi">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource FontIkon}" Margin="2,0,10,0" />
                            <TextBlock Text="Keluar"
                                       Visibility="{Binding DataContext.Sempit, RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolKasus}, ConverterParameter=balik}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Versi}" Foreground="#80CFE4DE" FontSize="10.5" Margin="12,8,0,0"
                               Visibility="{Binding DataContext.Sempit, RelativeSource={RelativeSource AncestorType=Window},
                                            Converter={StaticResource BoolKasus}, ConverterParameter=balik}" />
                </StackPanel>

                <ListBox Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                         ItemsSource="{Binding Menu}" SelectedItem="{Binding MenuAktif}"
                         ItemContainerStyle="{StaticResource MenuSisi}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Rel ikon: hanya ikon yang tampil. -->
                                <TextBlock Text="{Binding Ikon}" FontFamily="{StaticResource FontIkon}"
                                           FontSize="16" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource KuasSisiTeks}"
                                           Visibility="{Binding DataContext.Sempit, RelativeSource={RelativeSource AncestorType=Window},
                                                        Converter={StaticResource BoolKasus}}" />
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding DataContext.Sempit, RelativeSource={RelativeSource AncestorType=Window},
                                                         Converter={StaticResource BoolKasus}, ConverterParameter=balik}">
                                    <!-- Titik penanda item aktif, seperti contoh desain. -->
                                    <TextBlock Text="&#x2022;" Foreground="White" FontSize="15" Width="18"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected,
                                                                   RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Judul}" Foreground="White" FontSize="14.5"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Kanan: bilah atas + halaman aktif. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Judul halaman menempel di latar, dipisah garis tipis seperti contoh desain. -->
            <Border Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource KuasGaris}"
                    BorderThickness="0,0,0,1" Padding="32,26,32,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding MenuAktif.Judul}" Style="{StaticResource TeksJudul}"
                                   FontSize="32" />
                        <TextBlock Text="{Binding MenuAktif.Keterangan}" Style="{StaticResource TeksSub}"
                                   FontSize="13.5" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Lencana}">
                            <TextBlock Style="{StaticResource TeksLencana}"
                                       Text="{Binding Sesi.Sapaan, StringFormat={}{0}}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding Halaman}" Margin="32,20,32,12"
                            VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" />

            <!-- Toast: hasil/galat terakhir dari aksi apa pun. -->
            <Border Grid.Row="2" x:Name="KartuToast" HorizontalAlignment="Right" Margin="0,0,24,16"
                    Background="{DynamicResource KuasPermukaan}" BorderBrush="{DynamicResource KuasGaris}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusKecil}" Padding="14,9,14,9"
                    Visibility="Collapsed">
                <TextBlock x:Name="IsiToast" Style="{StaticResource TeksKecil}" MaxWidth="460"
                           TextWrapping="Wrap" Foreground="{DynamicResource KuasTeks}" />
            </Border>
        </Grid>
    </Grid>
</Window>
