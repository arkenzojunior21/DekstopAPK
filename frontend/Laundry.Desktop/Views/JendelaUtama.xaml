<Window x:Class="Laundry.Desktop.Views.JendelaUtama"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Laundry.Desktop.ViewModels"
        xmlns:v="clr-namespace:Laundry.Desktop.Views"
        Title="Laundry Desk" Height="760" Width="1200" MinHeight="540" MinWidth="880"
        Language="id-ID"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource KuasLatar}"
        FontFamily="{StaticResource FontUtama}">
    <Window.Resources>
        <!-- PlatformAdmin Views (placeholder - ViewModel belum dibuat, pakai BerandaAdminView) -->
        <DataTemplate DataType="{x:Type vm:BerandaAdminViewModel}">
            <v:BerandaAdminView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}">
            <v:AuditView />
        </DataTemplate>

        <!-- StoreAdmin Views (pakai ViewModel yang sudah ada + placeholder BerandaAdmin) -->
        <DataTemplate DataType="{x:Type vm:PesananViewModel}">
            <v:PesananView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PesanBaruViewModel}">
            <v:PesanBaruView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KatalogViewModel}">
            <v:KatalogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PelangganViewModel}">
            <v:PelangganView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SlotViewModel}">
            <v:SlotView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KomplainViewModel}">
            <v:KomplainView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LaporanViewModel}">
            <v:LaporanView />
        </DataTemplate>

        <!-- Customer Views -->
        <DataTemplate DataType="{x:Type vm:BerandaPelangganViewModel}">
            <v:BerandaPelangganView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PesananSayaViewModel}">
            <v:PesananSayaView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="KolomSisi" Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sisi kiri: menu sesuai peran. Menyempit jadi rel ikon saat jendela sempit. -->
        <Border Grid.Column="0" Background="{DynamicResource KuasSisi}">
            <DockPanel LastChildFill="True">
                <!-- Header Sidebar: Logo + Nama App + Role + Tenant (untuk StoreAdmin) -->
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,16">
                    <Grid x:Name="BarisLogo" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="38" Height="38" Grid.Column="0">
                            <Border CornerRadius="10" Background="{DynamicResource KuasAksen}">
                                <TextBlock Text="L" Foreground="White" FontWeight="Bold" FontSize="20"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding DataContext.Sempit, RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolKasus}, ConverterParameter=balik}">
                            <TextBlock Text="Laundry Desk" Foreground="White" FontSize="20" FontWeight="Bold" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Style="{StaticResource LencanaKecil}"
                                        Visibility="{Binding Sesi.PlatformAdmin}">
                                    <TextBlock Text="Platform Admin" Style="{StaticResource TeksLencanaKecil}" />
                                </Border>
                                <Border Style="{StaticResource LencanaKecil}"
                                        Visibility="{Binding Sesi.StoreAdmin}">
                                    <TextBlock Text="Store Admin" Style="{StaticResource TeksLencanaKecil}" />
                                </Border>
                                <Border Style="{StaticResource LencanaKecil}"
                                        Visibility="{Binding Sesi.Customer}">
                                    <TextBlock Text="Customer" Style="{StaticResource TeksLencanaKecil}" />
                                </Border>
                            </StackPanel>
                            <!-- Tenant info untuk StoreAdmin -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                        Visibility="{Binding Sesi.HasTenant}">
                                <TextBlock Text="&#xE80F;" FontFamily="{StaticResource FontIkon}" FontSize="10"
                                           Foreground="{DynamicResource KuasSisiTeks}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Sesi.TenantNama}" Foreground="{DynamicResource KuasSisiTeks}"
                                           FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="#1FFFFFFF" />
                </StackPanel>

                <!-- Footer Sidebar: Status Sync + Tema + Keluar + Versi -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,20">
                    <TextBlock Text="{Binding StatusSinkron}" Foreground="{DynamicResource KuasSisiTeks}"
                               FontSize="11" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding StatusSinkron, Converter={StaticResource Kosong}}" />
                    <Border Height="1" Background="#1FFFFFFF" Margin="0,0,0,12" />
                    <Button Command="{Binding GantiTemaCommand}" Style="{StaticResource TombolHalus}"
                            Foreground="{DynamicResource KuasSisiTeks}" HorizontalContentAlignment="Left"
                            ToolTip="Ganti tema tampilan">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE706;" FontFamily="{StaticResource FontIkon}" Margin="2,0,10,0" />
                            <TextBlock Text="{Binding NamaTema, StringFormat=Tema: {0}}"
                                       Visibility="{Binding DataContext.Sempit, RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource BoolKasus}, ConverterParameter=balik}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding KeluarCommand}" Style="{StaticResource TombolHalus}"
                            Foreground="{DynamicResource KuasSisiTeks}" HorizontalContentAlignment="Left"
                            ToolTip="Keluar dari aplikasi" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource FontIkon}" Margin="2,0,10,0" />
                            <TextBlock Text="Keluar"
                                       Visibility="{Binding DataContext.Sempit, RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource BoolKasus}, ConverterParameter=balik}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Versi}" Foreground="#80CFE4DE" FontSize="10" Margin="12,12,0,0"
                               Visibility="{Binding DataContext.Sempit, RelativeSource={RelativeSource AncestorType=Window},
                                           Converter={StaticResource BoolKasus}, ConverterParameter=balik}" />
                </StackPanel>

                <!-- Menu List -->
                <ListBox Background="Transparent" BorderThickness="0" Margin="0,8,0,0"
                         ItemsSource="{Binding Menu}" SelectedItem="{Binding MenuAktif}"
                         ItemContainerStyle="{StaticResource MenuSisi}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Height="44" Background="Transparent" Padding="14,0,14,0"
                                    BorderBrush="{DynamicResource KuasAksen}" BorderThickness="3,0,0,0"
                                    Margin="0,2,0,2"
                                    Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                                 Converter={StaticResource BoolKasus}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                         Value="True">
                                                <Setter Property="BorderThickness" Value="3,0,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <!-- Rel ikon: hanya ikon yang tampil saat sempit -->
                                    <TextBlock Text="{Binding Ikon}" FontFamily="{StaticResource FontIkon}"
                                               FontSize="17" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource KuasSisiTeks}"
                                               Visibility="{Binding DataContext.Sempit, RelativeSource={RelativeSource AncestorType=Window},
                                                            Converter={StaticResource BoolKasus}}" />
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding DataContext.Sempit, RelativeSource={RelativeSource AncestorType=Window},
                                                         Converter={StaticResource BoolKasus}, ConverterParameter=balik}">
                                        <TextBlock Text="{Binding Ikon}" FontFamily="{StaticResource FontIkon}"
                                                   FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource KuasSisiTeks}" />
                                        <TextBlock Text="{Binding Judul}" Foreground="White" FontSize="14"
                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Kanan: bilah atas + halaman aktif. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Judul halaman -->
            <Border Grid.Row="0" Background="{DynamicResource KuasPermukaan}" BorderBrush="{DynamicResource KuasGaris}"
                    BorderThickness="0,0,0,1" Padding="36,28,36,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding MenuAktif.Judul}" Style="{StaticResource TeksJudul}"
                                   FontSize="30" />
                        <TextBlock Text="{Binding MenuAktif.Keterangan}" Style="{StaticResource TeksSub}"
                                   FontSize="13" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Lencana}">
                            <TextBlock Style="{StaticResource TeksLencana}"
                                       Text="{Binding Sesi.Sapaan, StringFormat={}{0}}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding Halaman}" Margin="36,24,36,16"
                            VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" />

            <!-- Toast: hasil/galat terakhir dari aksi apa pun. -->
            <Border Grid.Row="2" x:Name="KartuToast" HorizontalAlignment="Right" Margin="0,0,28,20"
                    Background="{DynamicResource KuasPermukaan}" BorderBrush="{DynamicResource KuasGaris}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusKecil}" Padding="16,10,16,10"
                    Visibility="Collapsed" Effect="{StaticResource BayanganSedang}">
                <TextBlock x:Name="IsiToast" Style="{StaticResource TeksKecil}" MaxWidth="480"
                           TextWrapping="Wrap" Foreground="{DynamicResource KuasTeks}" />
            </Border>
        </Grid>
    </Grid>
</Window>
