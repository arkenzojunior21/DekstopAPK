<UserControl x:Class="Laundry.Desktop.Views.KatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Kiri: daftar layanan. -->
        <DockPanel Grid.Column="0" LastChildFill="True">
            <Border DockPanel.Dock="Top" Style="{StaticResource Kartu}" Padding="14,10,14,10" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Baru" Style="{StaticResource TombolGaris}"
                            VerticalAlignment="Top" Margin="10,0,0,0"
                            Command="{Binding BaruCommand}" />
                    <StackPanel>
                        <TextBlock Text="LAYANAN" Style="{StaticResource TeksLabel}" />
                        <TextBlock Text="Tarif disimpan sebagai versi baru setiap kali diubah, jadi pesanan lama tetap memakai harga saat ia dibuat."
                                   Style="{StaticResource TeksKecil}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Kartu}" Padding="0">
                <Grid>
                    <DataGrid Style="{StaticResource TabelData}" ItemsSource="{Binding Daftar}"
                              SelectedItem="{Binding Terpilih}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Foto" Width="58">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Nama, Converter={StaticResource FotoLayanan}}"
                                               Width="30" Height="30" Stretch="UniformToFill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source, RelativeSource={RelativeSource Self}}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Layanan" Binding="{Binding Nama}" Width="*" MinWidth="130"
                                                ElementStyle="{StaticResource SelPotong}" />
                            <DataGridTextColumn Header="Satuan"
                                                Binding="{Binding UnitType, Converter={StaticResource Label}}" Width="76"
                                                ElementStyle="{StaticResource SelPotong}" />
                            <DataGridTextColumn Header="Tarif"
                                                Binding="{Binding CurrentPrice, Converter={StaticResource Rupiah}}" Width="78" />
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding IsActive, Converter={StaticResource YaTidak}, ConverterParameter=Aktif|Nonaktif}"
                                                Width="78" ElementStyle="{StaticResource SelPotong}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Belum ada layanan. Tambahkan lewat tombol Baru di atas, lalu isi nama, tarif, dan estimasinya di panel kanan."
                               Style="{StaticResource TeksKecil}" TextWrapping="Wrap" Margin="18,56,18,18"
                               Visibility="{Binding Daftar.Count, Converter={StaticResource Kosong}, ConverterParameter=balik}" />
                </Grid>
            </Border>
        </DockPanel>

        <!-- Kanan: editor tarif + ongkos. -->
        <ScrollViewer Grid.Column="2" Style="{StaticResource Gulir}">
            <StackPanel>
                <ContentControl Content="{Binding Galat}" ContentTemplate="{StaticResource BarisGalat}"
                                Visibility="{Binding Galat, Converter={StaticResource Kosong}}" />
                <ContentControl Content="{Binding Hasil}" ContentTemplate="{StaticResource BarisHasil}"
                                Visibility="{Binding Hasil, Converter={StaticResource Kosong}}" />

                <Border Style="{StaticResource Kartu}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding Terpilih.Nama, FallbackValue=Layanan baru}" Style="{StaticResource TeksBagian}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource KotakLabel}" Tag="NAMA LAYANAN"
                                     Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Grid.Column="2" Style="{StaticResource KotakPilihLabel}" Tag="SATUAN"
                                      ItemsSource="{Binding SemuaSatuan}"
                                      SelectedItem="{Binding Satuan}" ItemTemplate="{StaticResource TemplateEnum}" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource KotakLabel}" Tag="TARIF (RP)"
                                     Text="{Binding Tarif, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2" Style="{StaticResource KotakLabel}" Tag="MINIMUM BERAT (KG)"
                                     Text="{Binding MinimumBerat, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="4" Style="{StaticResource KotakLabel}" Tag="TAMBAHAN EXPRESS"
                                     Text="{Binding TambahanExpress, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource KotakLabel}" Tag="STANDAR (HARI)"
                                     Text="{Binding HariStandar, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2" Style="{StaticResource KotakLabel}" Tag="EXPRESS (HARI)"
                                     Text="{Binding HariExpress, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Grid.Column="3" Style="{StaticResource KotakCek}" Content="Aktif" Margin="12,26,0,0"
                                      VerticalAlignment="Top" IsChecked="{Binding Aktif}" />
                        </Grid>

                        <Button Content="Simpan layanan &amp; tarif" Style="{StaticResource Tombol}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Height="44"
                                Command="{Binding SimpanCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Kartu}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource KotakLabel}" Tag="ONGKOS ANTAR-JEMPUT (RP)"
                                     Text="{Binding Ongkos, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="Simpan ongkos" Style="{StaticResource TombolGaris}"
                                    VerticalAlignment="Center"
                                    Command="{Binding SimpanOngkosCommand}" />
                        </Grid>
                        <TextBlock Style="{StaticResource TeksKecil}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Satu tarif flat dipakai untuk semua kondisi antar-jemput sampai aturan per kondisi ditambahkan." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
